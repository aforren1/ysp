+								if (cur_font_is_fallback || !skb_font_collection_font_has_codepoint(layout->params.font_collection, cur_font_handle, codepoint)) {
 									// Find new font
+									bool found = false;
 									for (int32_t k = 0; k < fonts_count; k++) {
