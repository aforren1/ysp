 										shaping_run->is_emoji = has_emoji;
 										shaping_run->content_run_idx = content_run_idx;
@@ -457,8 +545,9 @@
 										shaping_run->bidi_level = bidi_run->level;
 									}
 
-									font_run_start = j;
