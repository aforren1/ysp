+
+int32_t skb_font_collection_match_fallback_fonts(
+	const skb_font_collection_t* font_collection,
+	uint32_t codepoint, uint8_t requested_font_family,
+	skb_weight_t requested_weight, skb_style_t requested_style, skb_stretch_t requested_stretch,
+	skb_font_handle_t* results, int32_t results_cap)
+{
+	if (codepoint > 0x10ffff)
+		return 0;
+	return skb__match_fonts(
+		font_collection, "", 0, (int32_t)codepoint, requested_font_family,
+		requested_weight, requested_style, requested_stretch, results, results_cap);
 }
 
 bool skb_font_collection_font_has_codepoint(const skb_font_collection_t* font_collection, skb_font_handle_t font_handle, uint32_t codepoint)
diff --git a/src/skb_layout.c b/src/skb_layout.c
index 9fb73d2..1e21bf1 100644
--- a/src/skb_layout.c
+++ b/src/skb_layout.c
@@ -281,6 +281,75 @@
 	const SBRun* run_a = a;
 	const SBRun* run_b = b;
 	return (int)run_a->offset - (int)run_b->offset;
+}
+
+// Default ignorable codepoints need no glyph, HarfBuzz hides them. Same set as HarfBuzz's is_default_ignorable().
+static bool skb__is_default_ignorable(uint32_t codepoint)
+{
+	if ((codepoint >> 16) == 0) {
+		switch (codepoint >> 8) {
+		case 0x00: return codepoint == 0x00ad;
+		case 0x03: return codepoint == 0x034f;
+		case 0x06: return codepoint == 0x061c;
+		case 0x17: return codepoint >= 0x17b4 && codepoint <= 0x17b5;
+		case 0x18: return codepoint >= 0x180b && codepoint <= 0x180f;
+		case 0x20: return (codepoint >= 0x200b && codepoint <= 0x200f) || (codepoint >= 0x202a && codepoint <= 0x202e) || (codepoint >= 0x2060 && codepoint <= 0x206f);
+		case 0xfe: return (codepoint >= 0xfe00 && codepoint <= 0xfe0f) || codepoint == 0xfeff;
+		case 0xff: return codepoint >= 0xfff0 && codepoint <= 0xfff8;
+		default: return false;
+		}
+	}
+	if ((codepoint >> 16) == 0x01)
+		return codepoint >= 0x1d173 && codepoint <= 0x1d17a;
+	if ((codepoint >> 16) == 0x0e)
+		return codepoint >= 0xe0000 && codepoint <= 0xe0fff;
+	return false;
+}
+
+// Font fallback for a codepoint that none of the fonts of the run's script has (e.g. digits and punctuation,
+// which take the script of the text around them). Like browsers, the codepoint's grapheme cluster is taken whole
+// from the first font of the family, in the order the fonts were added, that has every codepoint of the cluster,
+// so that marks stay with their base. If no font has the whole cluster, the first font that has the codepoint.
+// The cluster does not reach before range_start (the start of the current font run). Returns 0 if no font has the codepoint.
+// Kept out of line: inlined into skb__itemize(), it made the font split of text that needs no fallback slower.
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static skb_font_handle_t skb__match_fallback_font(
+	const skb_layout_t* layout, int32_t offset, int32_t range_start, int32_t range_end,
+	uint8_t font_family, skb_weight_t font_weight, skb_style_t font_style, skb_stretch_t font_stretch,
+	skb_range_t* fallback_range)
+{
+	skb_font_handle_t fonts[32];
+	const int32_t fonts_count = skb_font_collection_match_fallback_fonts(
+		layout->params.font_collection, layout->text[offset], font_family,
+		font_weight, font_style, font_stretch,
+		fonts, SKB_COUNTOF(fonts));
+	if (fonts_count == 0)
+		return 0;
+
+	skb_range_t cluster = { .start = offset, .end = offset + 1 };
+	while (cluster.start > range_start && !(layout->text_props[cluster.start - 1].flags & SKB_TEXT_PROP_GRAPHEME_BREAK))
+		cluster.start--;
+	while (cluster.end < range_end && !(layout->text_props[cluster.end - 1].flags & SKB_TEXT_PROP_GRAPHEME_BREAK))
+		cluster.end++;
+
+	for (int32_t k = 0; k < fonts_count; k++) {
+		bool has_cluster = true;
+		for (int32_t i = cluster.start; i < cluster.end && has_cluster; i++) {
+			const uint32_t codepoint = layout->text_props[i].flags & SKB_TEXT_PROP_CONTROL ? 32 : layout->text[i];
+			has_cluster = skb__is_default_ignorable(codepoint) || skb_font_collection_font_has_codepoint(layout->params.font_collection, fonts[k], codepoint);
+		}
+		if (has_cluster) {
+			*fallback_range = cluster;
+			return fonts[k];
+		}
+	}
+
+	*fallback_range = (skb_range_t){ .start = offset, .end = offset + 1 };
+	return fonts[0];
 }
 
 static void skb__itemize(skb__layout_build_context_t* build_context, skb_layout_t* layout)
