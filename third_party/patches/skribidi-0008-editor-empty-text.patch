Subject: [PATCH] editor: empty editors, the text's ends and empty paragraphs

Faults of the editor at the edges of its text, found by a fuzz target
and by commands on empty, one-character and separator-only texts. Each
fix keeps what the code does on other texts.

1. An editor with no paragraph. skb_editor_create() and
   skb_editor_reset() leave the rich text and layout with no paragraph
   until text is set or inserted (an undo of the first edit does too).
   skb_editor_select_all(), skb_editor_process_mouse_click() and
   skb_rich_layout_get_caret_info_at() return early then; other paths
   read paragraph 0 of none:
   - a caret move (Left, Right, Up, Down, Home, End, with any modifier):
     skb_rich_layout_get_direction() or skb_rich_layout_get_layout()
     asserts in a Debug build and reads through NULL in a Release one.
     skb_editor_process_key_pressed() now ignores a move with no
     paragraph; Backspace, Delete and Enter are unchanged.
   - skb_editor_get_line_index_at() and skb_editor_get_column_index_at()
     (the same): they return 0.
   - the first IME composition, skb_editor_set_composition_utf32(),
     through skb_editor_get_selection_ordered_start() (the same): the
     two ordered getters return the range's own start and end.
   - skb_editor_iterate_text_range_bounds(), through
     skb_rich_layout_get_text_range_bounds(): it read paragraph -1
     (UBSan, or ASan after an undo); it now calls back nothing.

2. Word boundaries read text properties outside the text.
   - skb__advance_word_forward() (Ctrl+Right, or Ctrl+Left in RTL text,
     default behavior) read text_props[next_offset] when the last word
     ends at the text's end ("ab"; ASan). It now stops there, as it did
     when the value read had no whitespace flag.
   - skb_editor_get_word_start_at() (a double click) read
     text_props[-1] at offset 0 (ASan). The loop now ends at 0, the
     offset it returned before.

3. skb_text_append_utf32_with_payload() called memcpy() with a NULL
   destination and a size of 0 for a text that never held a codepoint:
   each empty paragraph that skb_rich_text_append_utf32_with_payload()
   makes (Enter, a set or inserted text that ends in a paragraph
   separator, an empty set text) gets an empty append (UBSan). The copy
   is now skipped for 0 codepoints, as skb_text_insert_utf32_with_payload()
   does.

Recorded in ysp's docs/layout.md (Patch 0008). Applies to skribidi
dee63d6 after skribidi-0001 to skribidi-0007.

diff --git a/src/skb_editor.c b/src/skb_editor.c
--- a/src/skb_editor.c
+++ b/src/skb_editor.c
@@ -1020,7 +1020,8 @@ skb_text_position_t skb_editor_get_word_start_at(const skb_editor_t* editor, skb
 	const skb_text_property_t* text_props = skb_layout_get_text_properties(skb__get_layout(editor, paragraph_pos.paragraph_idx));
 
 	if (text_props) {
-		while (offset >= 0) {
+		// At offset 0 there is no property before the text to read; the word starts there.
+		while (offset > 0) {
 			if (text_props[offset-1].flags & SKB_TEXT_PROP_WORD_BREAK) {
 				offset = skb_layout_align_grapheme_offset(skb__get_layout(editor, paragraph_pos.paragraph_idx), offset);
 				break;
@@ -1077,6 +1078,10 @@ skb_text_position_t skb_editor_get_selection_ordered_start(const skb_editor_t* e
 	assert(skb__are_paragraphs_in_sync(editor));
 
 	text_range = skb__resolve_text_range(editor, text_range);
+	// An editor with no text (skb_editor_create(), skb_editor_reset()) has no paragraph direction to order by,
+	// and its selection is empty; the IME's first composition in a new editor comes here.
+	if (skb__get_paragraph_count(editor) <= 0)
+		return text_range.start;
 	// Get positions separate (not range) so that we can compare the direction.
 	skb_paragraph_position_t start_pos = skb_rich_text_get_paragraph_position_from_text_position(&editor->rich_text, text_range.start, SKB_AFFINITY_USE);
 	skb_paragraph_position_t end_pos = skb_rich_text_get_paragraph_position_from_text_position(&editor->rich_text, text_range.end, SKB_AFFINITY_USE);
@@ -1093,6 +1098,10 @@ skb_text_position_t skb_editor_get_selection_ordered_end(const skb_editor_t* edi
 	assert(skb__are_paragraphs_in_sync(editor));
 
 	text_range = skb__resolve_text_range(editor, text_range);
+	// An editor with no text (skb_editor_create(), skb_editor_reset()) has no paragraph direction to order by,
+	// and its selection is empty; the IME's first composition in a new editor comes here.
+	if (skb__get_paragraph_count(editor) <= 0)
+		return text_range.end;
 	// Get positions separate (not range) so that we can compare the direction.
 	skb_paragraph_position_t start_pos = skb_rich_text_get_paragraph_position_from_text_position(&editor->rich_text, text_range.start, SKB_AFFINITY_USE);
 	skb_paragraph_position_t end_pos = skb_rich_text_get_paragraph_position_from_text_position(&editor->rich_text, text_range.end, SKB_AFFINITY_USE);
@@ -1343,7 +1352,8 @@ static skb_text_position_t skb__advance_word_forward(const skb_editor_t* editor,
 		while (offset < text_count) {
 			if (text_props[offset].flags & SKB_TEXT_PROP_WORD_BREAK) {
 				int32_t next_offset = skb_layout_get_next_grapheme_offset(skb__get_layout(editor, cur_edit_pos.paragraph_idx), offset);
-				if (!(text_props[next_offset].flags & SKB_TEXT_PROP_WHITESPACE)) {
+				// After the last grapheme there is no property to read; the move ends at the text's end.
+				if (next_offset >= text_count || !(text_props[next_offset].flags & SKB_TEXT_PROP_WHITESPACE)) {
 					offset = next_offset;
 					break;
 				}
@@ -2265,6 +2275,11 @@ void skb_editor_process_key_pressed(skb_editor_t* editor, skb_temp_alloc_t* temp
 {
 	assert(editor);
 
+	// skb_editor_create() and skb_editor_reset() leave the editor with no paragraph until text is set or inserted.
+	// The caret moves read the caret's paragraph; with no text there is nowhere to move.
+	if (skb__get_paragraph_count(editor) <= 0 && key != SKB_KEY_BACKSPACE && key != SKB_KEY_DELETE && key != SKB_KEY_ENTER)
+		return;
+
 	if (key == SKB_KEY_RIGHT) {
 		if (editor->params.editor_behavior == SKB_BEHAVIOR_MACOS) {
 			if (mods & SKB_MOD_SHIFT) {
@@ -3044,6 +3059,9 @@ void skb_editor_clear_composition(skb_editor_t* editor, skb_temp_alloc_t* temp_a
 int32_t skb_editor_get_line_index_at(const skb_editor_t* editor, skb_text_position_t text_pos)
 {
 	assert(editor);
+	// An editor with no text has no paragraph to read (skb_editor_create(), skb_editor_reset()).
+	if (skb__get_paragraph_count(editor) <= 0)
+		return 0;
 
 	text_pos = skb__resolve_text_position(editor, text_pos);
 	skb_paragraph_position_t paragraph_pos = skb_rich_text_get_paragraph_position_from_text_position(&editor->rich_text, text_pos, SKB_AFFINITY_USE);
@@ -3062,6 +3080,9 @@ int32_t skb_editor_get_line_index_at(const skb_editor_t* editor, skb_text_positi
 int32_t skb_editor_get_column_index_at(const skb_editor_t* editor, skb_text_position_t text_pos)
 {
 	assert(editor);
+	// An editor with no text has no paragraph to read (skb_editor_create(), skb_editor_reset()).
+	if (skb__get_paragraph_count(editor) <= 0)
+		return 0;
 
 	text_pos = skb__resolve_text_position(editor, text_pos);
 	skb_paragraph_position_t paragraph_pos = skb_rich_text_get_paragraph_position_from_text_position(&editor->rich_text, text_pos, SKB_AFFINITY_USE);
diff --git a/src/skb_rich_layout.c b/src/skb_rich_layout.c
--- a/src/skb_rich_layout.c
+++ b/src/skb_rich_layout.c
@@ -466,6 +466,10 @@ skb_caret_info_t skb_rich_layout_get_caret_info_at(const skb_rich_layout_t* rich
 void skb_rich_layout_get_text_range_bounds(const skb_rich_layout_t* rich_layout, skb_text_range_t text_range, skb_text_range_bounds_func_t* callback, void* context)
 {
 	assert(rich_layout);
+	// An editor with no text has no paragraph (skb_editor_create(), skb_editor_reset(), an undo of the first edit),
+	// and so no bounds; skb_rich_layout_get_caret_info_at() returns early the same way.
+	if (rich_layout->paragraphs_count == 0)
+		return;
 
 	skb_paragraph_position_t start_pos = skb__rich_layout_get_paragraph_position_from_text_position(rich_layout, text_range.start, SKB_AFFINITY_USE);
 	skb_paragraph_position_t end_pos = skb__rich_layout_get_paragraph_position_from_text_position(rich_layout, text_range.end, SKB_AFFINITY_USE);
diff --git a/src/skb_text.c b/src/skb_text.c
--- a/src/skb_text.c
+++ b/src/skb_text.c
@@ -625,7 +625,10 @@ void skb_text_append_utf32_with_payload(skb_text_t* text, const uint32_t* utf32,
 		.end = text->text_count + utf32_count,
 	};
 
-	memcpy(text->text + text->text_count, utf32, utf32_count * sizeof(uint32_t));
+	// A text that never held a codepoint has no buffer, and memcpy() must not get NULL even to copy nothing:
+	// an empty paragraph (after Enter, or at the end of text that ends in a paragraph separator) appends 0.
+	if (utf32_count > 0)
+		memcpy(text->text + text->text_count, utf32, utf32_count * sizeof(uint32_t));
 	text->text_count += utf32_count;
 	skb__update_grapheme_breaks(text, range.start);
 
