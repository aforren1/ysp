# build output
build*/
compile_commands.json
*.o
*.obj
*.so
*.dll
*.pyd
*.mex*
*.oct
*.exe
*.pdb
*.ilk
*.exp

# example output written to the working directory (data files, --shots images)
/*.csv
/*.ppm
/*.pgm

# libFuzzer artifacts (tests/fuzz/)
crash-*
leak-*
timeout-*
oom-*
slow-unit-*
*.profraw

# python
__pycache__/
.pytest_cache/
.venv/
dist/
wheelhouse/
*.egg-info/
*.egg

# headers staged into a python binding for isolated/CI builds
bindings/python/*/include/
# miniaudio.h for the ysp_audio MEX build (build.m)
bindings/mex/miniaudio/
# ysp-vis natives staged for an isolated build, and the license notices
# build.m copies beside the MEX files (tools/vendor_vis.py makes them)
bindings/python/ysp_vis/natives/
bindings/mex/ysp_vis-LICENSE.*.txt

# logs and crash dumps
logs/
*.log
*.stackdump
*.dmp

# editor / OS
.vscode/
.cache/
CMakeUserPresets.json
.DS_Store

# vendored layout sources: fetched and verified by tools/vendor_layout.py
# (third_party/README.md); the recipe (patches, manifest, CMake) is tracked.
# Also lodepng (tools/vendor_pack.py), liblsl (tools/vendor_lsl.py), and
# ysp-vis's static SDL3 and ANGLE (tools/vendor_vis.py).
/third_party/*/
!/third_party/patches/
# Probe output folders (tests/probe/beam_race, tests/probe/screen_x11)
/beam_*/
/ysp_beam_race_*/
/ysp_x11_probe_*/
/.claude/worktrees/
