{
  "format": "ysp-experiment",
  "version": 2,
  "roles": {
    "hand": {
      "type": "position2d",
      "units": "display_px",
      "allow_relative": true
    }
  },
  "stimuli": {
    "s": {
      "kind": "shape"
    },
    "dot": {
      "kind": "shape"
    }
  },
  "trials": {
    "t": {
      "controls": {
        "cur": {
          "control": "cursor",
          "role": "hand"
        },
        "near": {
          "control": "region",
          "of": "hand",
          "radius": 10
        }
      },
      "states": [
        {
          "name": "a",
          "steps": [
            {
              "on": "s"
            }
          ],
          "exits": [
            {
              "on": "near",
              "to": "end",
              "outcome": "hit"
            },
            {
              "on": "response",
              "to": "end"
            }
          ]
        },
        {
          "name": "b",
          "steps": [
            {
              "wait_s": 0.5
            }
          ]
        }
      ],
      "response": {
        "role": "kb",
        "choices": [
          "f",
          "j"
        ],
        "from": "s",
        "key_answer": "f",
        "duration_s": 2
      },
      "columns": {
        "score": {
          "by": "$outcome",
          "map": {
            "correct": 1,
            "wrong": 0,
            "timeout": -1
          }
        }
      }
    }
  },
  "timeline": [
    {
      "name": "m",
      "trial": "t"
    }
  ],
  "devices": {
    "kb": {
      "direction": "in",
      "family": [
        "keyboard"
      ]
    }
  }
}
