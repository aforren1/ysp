template t
  events
  after
  record_given=0 record=[]
  outcome=int:1 method_value=(null)
  column depth_max = signal(depth lanes=1)
  column lift_z = hit(lift.z)
  control depth kind=peak shared=0 lanes=1 test=0 hits=0 of=pad.z(role 0 lanes=1)
    lag_s (default) = dur:10000000ns
    measure (default) = "speed"
    of = "pad.z"
  control lift kind=region shared=0 lanes=1 test=1 hits=1 of=pad(role 0 lanes=3)
    center (default) = [int:0, int:0]
    of = "pad"
    outside = true
    radius = int:5
    rate (default) = "sample"
    speed_lag_s (default) = dur:10000000ns
    stay_s (default) = dur:0ns
  states 2
    state show max_visits=0
      step on s stagger=dur:0ns
      step until target=lift(control)
    state choose max_visits=0
      exit if=practice to=show(state 0)
  shared exit after=dur:3000000000ns to=end(end) in=[1]
