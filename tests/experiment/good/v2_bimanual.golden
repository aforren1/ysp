  node b6_track path=blocks/b6_track trial=track table=- reps=1 interleave=0 track_rate=0 if=- unless=- loop=0 requeue=0 record_data=1
    rules="reps 2"
    jitters=[] rule_vars=[] tracks=[]
    var perturb = "rotation"
  node b7_reach path=blocks/b7_reach trial=reach table=- reps=1 interleave=0 track_rate=0 if=- unless=- loop=0 requeue=0 record_data=1
    rules="reps 30"
    jitters=[] rule_vars=[] tracks=[]
    var perturb = "rotation"
  node b8_track path=blocks/b8_track trial=track table=- reps=1 interleave=0 track_rate=0 if=- unless=- loop=0 requeue=0 record_data=1
    rules="reps 2"
    jitters=[] rule_vars=[] tracks=[]
    var perturb = "rotation"
  node b9_track path=blocks/b9_track trial=track table=- reps=1 interleave=0 track_rate=0 if=- unless=- loop=0 requeue=0 record_data=1
    rules="reps 2"
    jitters=[] rule_vars=[] tracks=[]
    var perturb = "none"
