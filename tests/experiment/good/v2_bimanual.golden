definition version=2 name="bimanual_tracking"
units_deg=0 background=0.05,0.05,0.05 calibration_required=0 min_tier=0 web_allowed=0 web_exclusion=0
units=2
field participant integer required=1
signal role left type=1 units=1 lanes=2 allow_relative=0 required=1
signal role right type=1 units=1 lanes=2 allow_relative=0 required=1
control cursor kind=cursor shared=1 lanes=2 test=0 hits=0 x=left.x(role 0 lanes=1) y=right.y(role 1 lanes=1) stimulus=dot(stimulus 0)
  about (default) = [int:0, int:0]
  stimulus = "dot"
  transform = lookup($perturb){"none": "identity", "rotation": rotation_deg(int:-90)}
  x = "left.x"
  y = "right.y"
