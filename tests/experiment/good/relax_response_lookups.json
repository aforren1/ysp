{
  "format": "ysp-experiment", "version": 1, "name": "relax_response_lookups",
  "note": "outcome and method_value run only on a trial with a response, so a lookup by $response, $responded or $outcome in them needs no key for a timeout (ysp/experiment.h 0.1.2)",
  "devices": { "resp": { "direction": "in", "family": ["keyboard"] } },
  "stimuli": { "s": { "kind": "shape", "w": 40 } },
  "methods": { "m": { "type": "stair", "steps": [1], "stop_trials": 4 } },
  "trials": { "t": { "events": [{ "on": "s" }],
                     "response": { "role": "resp", "from": "s", "choices": ["a", "b"], "key_answer": "a", "duration_s": 1 },
                     "outcome": { "by": "$response", "map": { "a": 1, "b": 0 } },
                     "method_value": { "by": "$responded", "map": { "true": { "by": "$outcome", "map": {
                                         "correct": "$level", "wrong": { "by": "$response", "map": { "a": 1, "b": 2 } } } } } } } },
  "timeline": [{ "name": "n", "trial": "t", "tracks": ["m"] }]
}
