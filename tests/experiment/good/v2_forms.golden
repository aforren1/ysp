definition version=2 name="forms"
units_deg=0 background=0.5,0.5,0.5 calibration_required=0 min_tier=0 web_allowed=0 web_exclusion=0
units=0
field participant integer required=1
signal role grip type=3 units=4 lanes=1 allow_relative=0 required=0
signal role pen type=1 units=0 lanes=2 allow_relative=0 required=1
control pointer kind=cursor shared=1 lanes=2 test=0 hits=0 of=pen(role 1 lanes=2) stimulus=dot(stimulus 1)
  about = [int:10, $cy]
  role = "pen"
  stimulus = "dot"
  transform = lookup($map){"flipped": mirror_deg(int:45), "plain": "identity", "turned": rotation_deg($angle)}
control squeeze kind=peak shared=1 lanes=1 test=0 hits=0 of=grip(role 0 lanes=1)
  lag_s (default) = dur:10000000ns
  measure (default) = "speed"
  of = "grip"
