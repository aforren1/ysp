  dash_snap (default) = int:0
  edge = "cosine"
  edge_width = int:1
  gap (default) = int:0
  gate (default) = int:1
  h = int:16
  join (default) = "round"
  miter_limit (default) = int:4
  offset (default) = int:0
  opacity (default) = int:1
  ori (default) = int:0
  p0 (default) = int:0
  p1 (default) = int:0
  p10 (default) = int:0
  p11 (default) = int:0
  p12 (default) = int:0
