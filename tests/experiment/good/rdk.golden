definition version=1 name="rdk_direction"
units_deg=0 background=0.5,0.5,0.5 calibration_required=0 min_tier=0 web_allowed=0 web_exclusion=0
field participant integer required=1
role resp dir=0 family=[keyboard] required=1 min_tier=0 pulse_ns=0 kind=
stimulus dots kind=7 layer=1
  algorithm (default) = "custom"
  anchor (default) = "center"
  aperture (default) = "circle"
  ax (default) = real:0.5
  ay (default) = real:0.5
  clock (default) = "onset"
  coherence = $coherence
  color = [int:1, int:1, int:1]
  count = int:200
  density (default) = int:0
  direction = $coherent_direction
  dot_size = int:4
  edge (default) = "wrap"
  edge_width (default) = int:0
  frame_s (default) = dur:0ns
  gate (default) = int:1
  h (default) = int:0
  lifetime_frames (default) = int:0
  lifetime_s (default) = dur:0ns
  miter_limit (default) = int:4
  noise (default) = "direction"
  opacity (default) = int:1
  ori (default) = int:0
  place (default) = "center"
  select (default) = "exact"
  sets (default) = int:1
  shape_p0 (default) = int:0
  shape_p1 (default) = int:0
  shape_p2 (default) = int:0
  shape_p3 (default) = int:0
  signal (default) = "same"
  speed = int:200
  stroke (default) = int:0
  stroke_align (default) = "center"
  visible (default) = int:1
  w = int:400
  x (default) = int:0
  y (default) = int:0
stimulus fix kind=0 layer=0
