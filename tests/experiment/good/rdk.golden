template rdk
  events
    step on fix stagger=dur:0ns
    step wait t=dur:500000000ns
    step on dots stagger=dur:0ns
  after
    step off dots fix stagger=dur:0ns
    step wait t=dur:800000000ns
  response role=resp from=dots ends=1 max=0 held=0 release=0 choices=left:left,right:right
    duration=dur:1500000000ns min_rt=dur:100000000ns key_answer=$key_answer trigger=- 
  record_given=0 record=[dots]
  outcome="correct" method_value=$level
node main path=main trial=rdk table=conditions.pstb reps=1 interleave=0 track_rate=0 if=- unless=- loop=0 requeue=0 record_data=1
  rules="order random\x0areps 5"
  jitters=[] rule_vars=[] tracks=[]
