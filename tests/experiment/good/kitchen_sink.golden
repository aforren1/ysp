definition version=1 name="kitchen_sink"
units_deg=1 background=0.25,0.5,1 calibration_required=1 min_tier=3 web_allowed=1 web_exclusion=1
field group string required=0
field participant integer required=1
role resp dir=0 family=[xid keyboard] required=1 min_tier=2 pulse_ns=0 kind=
  button 1 = "left"
  button 2 = "right"
  map key = "5"
