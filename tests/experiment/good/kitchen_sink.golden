  target_p (default) = int:0
  target_value (default) = int:0
method qp type=1 log10=1 estimate=mode dims=[]
  joint_prior (default) = []
  n_outcomes (default) = int:2
  no_table (default) = false
  param = [linspace[int:0, int:1, int:5], int:2, real:0.5, real:0.01]
  pf = "weibull"
  select (default) = "entropy"
  select_param (default) = int:0
  select_quantile (default) = real:0.5
  stim = [[real:0.1, real:0.5, int:1], linspace[int:-1, gamut(g.contrast), int:11]]
  stop_entropy (default) = int:0
  stop_sd (default) = int:0
  stop_sd_param (default) = int:0
  stop_trials = int:40
  subset_size (default) = int:0
  tie_tolerance (default) = real:0.000000001
  tiebreak (default) = "lowest"
method st type=0 log10=0 estimate=trials dims=[]
  est_reversals (default) = int:0
  est_trials (default) = int:0
  harder_is_up (default) = false
  initial_rule (default) = false
  max = gamut(g.contrast)
  min = real:0.01
  n_down = int:2
  n_up (default) = int:1
  rule (default) = "updown"
  start = real:0.5
  step_down_scale (default) = int:1
  step_type = "db"
  steps = [int:2, int:1]
  stop_at_limit (default) = int:0
  stop_reversals = int:8
  stop_trials (default) = int:0
  target_p (default) = int:0
  use_limits (default) = false
template full
  events
    step on g bar stagger=dur:10000000ns
    step if cond=practice
      step on img stagger=dur:0ns
      step off img stagger=dur:0ns
    step unless cond=first_in_block
      step wait t=$soa_s
    step set g
      contrast = real:0.5
      x = $n
    step to bar duration=dur:200000000ns delay=dur:10000000ns ease=cosine
      contrast = int:0
    step then bar duration=dur:100000000ns delay=dur:0ns ease=linear
      ori = int:45
    step at t=dur:1500000000ns
    step trigger code=lookup($cond){"a": int:10, "b": int:20} role=trig
    step mark mark=stim_on
    step on tone stagger=dur:0ns
    step off bar stagger=dur:0ns
  after
    step on lbl stagger=dur:0ns
    step off g stagger=dur:0ns
  response role=resp from=g ends=0 max=2 held=1 release=1 choices=left:left,right:r
    duration=lookup($cond){"a": dur:1500000000ns, "b": dur:2000000000ns} min_rt=dur:100000000ns key_answer=$side trigger=trig lookup($response){"left": int:1, "right": int:2}
  record_given=1 record=[g bar]
  outcome=lookup($correct){"false": int:0, "true": int:1} method_value=$contrast_shown
  column est = $estimate
  column group = $group
  column method_name = lookup($method){"ae": "aep", "qp": "quest", "st": "stair"}
  column resp_s = $rt_s
  column seconds_s = dur:1500000000ns
  column shown = $contrast_shown
  column side = $side
template plain
  events
    step on movie stagger=dur:0ns
    step wait t=$hold_s
    step on dots stagger=dur:0ns
    step on lit stagger=dur:0ns
    step on n1 stagger=dur:0ns
    step on art stagger=dur:0ns
  after
  record_given=0 record=[]
  outcome="" method_value=(null)
node blockA path=blockA trial=- table=base.pstb reps=2 interleave=0 track_rate=0 if=- unless=- loop=1:0.8,3 requeue=0 record_data=1
  rules=""
  jitters=[] rule_vars=[] tracks=[]
  var coh = choice[real:0.1, real:0.5]
  var wordv = choice["hello", "world"]
  data block_kind = "main"
  data p = $participant
  node adaptive path=blockA/adaptive trial=full table=- reps=1 interleave=1 track_rate=1 if=- unless=flag loop=0 requeue=1 record_data=0
    rules="order random  # a comment\x0areps 2\x0ajitter soa_s uniform 0.8 1.2\x0avar \"side\" choice left right"
    jitters=[soa_s] rule_vars=[side(left,right)] tracks=[st qp ae]
    var hold_s = dur:500000000ns
    data seconds_s = dur:2000000000ns
  node plain_leaf path=blockA/plain_leaf trial=plain table=- reps=1 interleave=0 track_rate=0 if=flag unless=- loop=0 requeue=0 record_data=1
    rules="practice 2\x0awarmup 0\x0ablock_size 2\x0agroups cond alternate"
    jitters=[] rule_vars=[] tracks=[]
    var hold_s = dur:1250000000ns
