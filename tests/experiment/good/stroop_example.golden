  visible (default) = int:1
  w (default) = int:0
  width = int:1000
  x (default) = int:0
  y (default) = int:0
template stroop
  events
    step if cond=first_in_block
      step on banner keys stagger=dur:0ns
      step wait t=dur:1500000000ns
      step off banner keys stagger=dur:0ns
    step on fix stagger=dur:0ns
    step wait t=dur:500000000ns
    step off fix stagger=dur:0ns
    step on word stagger=dur:0ns
  after
    step off word stagger=dur:0ns
    step if cond=practice
      step on feedback stagger=dur:0ns
      step wait t=dur:600000000ns
      step off feedback stagger=dur:0ns
    step wait t=dur:400000000ns
  response role=resp from=word ends=1 max=0 held=0 release=0 choices=r:red,g:green,b:blue
    duration=dur:2000000000ns min_rt=dur:100000000ns key_answer=$answer trigger=- 
  record_given=0 record=[word]
  outcome="correct" method_value=$level
  column feedback = lookup($practice){"false": "", "true": $outcome}
node main path=main trial=stroop table=stroop.pstb reps=1 interleave=0 track_rate=0 if=- unless=- loop=0 requeue=0 record_data=1
  rules="order constrained\x0aweight weight\x0amax_run congruent=1 3\x0apractice 4"
  jitters=[] rule_vars=[] tracks=[]
