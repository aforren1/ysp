stimulus word kind=5 layer=0
  aliased (default) = int:0
  align (default) = "start"
  anchor (default) = "center"
  ax (default) = real:0.5
  ay (default) = real:0.5
  blend (default) = "over"
  color = lookup($ink){"blue": [real:0.07, real:0.15, real:0.85], "green": [real:0.04, real:0.42, real:0.05], "red": [real:0.7, real:0.04, real:0.03]}
