{
  "format": "ysp-experiment", "version": 1, "name": "relax_level_by_method",
  "note": "on a leaf with tracks and a table, $level has a value on a track trial: in a lookup by $method's entry for a method, through vars too, and in method_value (ysp/experiment.h 0.1.2)",
  "devices": { "resp": { "direction": "in", "family": ["keyboard"] } },
  "stimuli": { "s": { "kind": "shape", "w": { "by": "$method", "map": { "st": "$level", "": "$n" } }, "h": "$x" } },
  "methods": { "st": { "type": "stair", "steps": [1], "stop_trials": 4 } },
  "trials": { "t": { "events": [{ "on": "s" }],
                     "response": { "role": "resp", "from": "s", "choices": ["a"], "key_answer": "a", "duration_s": 1 },
                     "method_value": { "by": "$response", "map": { "a": "$level" } } } },
  "timeline": [{ "name": "n", "trial": "t", "tracks": ["st"], "track_rate": 0.5, "timeline_variables": "base.pstb",
                 "vars": { "x": { "by": "$method", "map": { "st": "$level", "": 2 } } } }]
}
